<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net9.0-windows</TargetFrameworks>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <UseWpf>true</UseWpf>
    </PropertyGroup>

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Version>1.0.0-alpha10</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="chucker-Microsoft.TestApi.Wpf" Version="1.0.0"/>
        <PackageReference Include="Xunit.StaFact" Version="3.0.13"/>
        <PackageReference Include="xunit.v3.assert" Version="3.0.0"/>
    </ItemGroup>

</Project>
