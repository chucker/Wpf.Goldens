<Project>
    <PropertyGroup>
        <AllowUpdates Condition="'$(AllowUpdates)' == ''">false</AllowUpdates>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>AllowUpdates</_Parameter1>
            <_Parameter2>$(AllowUpdates)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
